{
    "version": 2,
    "configurePresets": [
      {
        "name": "common",
        "hidden": true,
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build"
      },
      {
        "name": "debug",
        "displayName": "Debug",
        "inherits": "common",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug",
          "CMAKE_C_COMPILER": "gcc",
          "CMAKE_CXX_COMPILER": "g++-14",
          "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
        }
      }
    ]
  }